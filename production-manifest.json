    "provider_data_controls": {
      "openai_platform_runtime_enabled": false,
      "openai_api_key_runtime_reference": false,
      "nvidia_trial_endpoint_may_record_inputs_outputs": true,
      "sensitive_data_allowed_on_trial_endpoint": false,
      "production_privacy_review_required": true,
      "preferred_production_endpoint": "partner_or_self_hosted_nim"
