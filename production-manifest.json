        "train_validation_split",
        "offline_metrics",
        "bias_review"
      ]
    },
    "deep_learning_or_finetuning": {
      "state": "research_only",
      "default_enabled": false,
      "required_evidence": [
        "baseline_comparison",
        "held_out_eval",
        "data_rights_review",
        "rollback_plan"
      ]
    },
    "autonomous_tools": {
      "state": "disabled",
      "default_enabled": false,
      "write_actions": false,
      "required_evidence": [
        "tool_allowlist",
        "structured_io",
        "prompt_injection_eval",
        "human_approval",
        "audit_log"
      ]
    }
