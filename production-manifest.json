      "human_review_required": true,
      "stage_latency_instrumentation": true,
      "retry_attempt_instrumentation": true,
      "request_metadata_fields": [
        "stage",
        "request_model",
        "max_tokens",
        "latency_seconds",
        "http_attempts",
        "retries",
        "status_codes",
        "request_ids",
        "configured_timeout_seconds",
        "configured_max_retries",
        "response_id",
        "response_model"
      ],
      "request_payload_logging": false
    }
  },
  "capabilities": {
    "text_llm": {
      "state": "enabled",
      "authority": "advisory_only"
    },
    "multimodal_image_input": {
      "state": "disabled",
      "default_enabled": false,
      "reason": "Nemotron 3 Ultra hosted baseline is text-only",
      "required_evidence": [
