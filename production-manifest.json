    "limits": {
      "max_input_chars": 4000,
      "max_history_messages": 20,
      "max_output_tokens": 512,
      "request_timeout_seconds": 45,
      "max_retries": 2,
      "session_requests_per_minute": 10
    },
    "evaluation": {
      "case_set": "evals/baseline.json",
      "runner": "scripts/run_model_eval.py",
      "workflow": ".github/workflows/model-eval.yml",
