  "baseline_sha": "27d6c202905d73dd417c38c75c083ade5ae26278",
  "adjudication_date": "2026-09-23",
  "runtime": {
    "interface": "streamlit",
    "container_user": "10001:10001",
    "health_endpoint": "/_stcore/health",
    "external_actions_enabled": false
  },
  "ai": {
    "provider": "nvidia_nim",
    "api": "openai_compatible_chat_completions",
    "base_url": "https://integrate.api.nvidia.com/v1",
    "production_model": "nvidia/nemotron-3-ultra-550b-a55b",
    "candidate_models_requiring_eval": [],
    "reasoning": {
      "enabled": false,
      "expose_reasoning_trace": false
    },
    "moderation": {
      "enabled": true,
      "provider": "nvidia_nim",
      "model": "nvidia/nemotron-3.5-content-safety",
      "input_and_output": true,
      "fail_closed_on_unrecognized_verdict": true
